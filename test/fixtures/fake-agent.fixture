#!/usr/bin/env node
const fs=require('node:fs');
if(process.argv[2]==='auth'){console.log(JSON.stringify({loggedIn:true}));process.exit(0);}
const rl=require('node:readline').createInterface({input:process.stdin});
let thread='claude-'+process.pid,turn=0,lock;
process.on('exit',()=>{if(lock)try{fs.unlinkSync(lock)}catch{}});
process.on('SIGTERM',()=>process.exit(0));
const emit=m=>process.stdout.write(JSON.stringify(m)+'\n');
rl.on('line',line=>{
 const m=JSON.parse(line); const p=m.params||{};
 if(m.type==='control_request') {emit({type:'control_response',response:{subtype:'success',request_id:m.request_id,response:{models:[{value:'sonnet',displayName:'Sonnet',supportedEffortLevels:['low','medium']},{value:'haiku',displayName:'Haiku'}]}}});return;}
 if(m.type==='user'){
  emit({type:'system',subtype:'init',session_id:thread,model:'sonnet'});
  fs.appendFileSync(process.env.TEST_AGENT_LOG,JSON.stringify({provider:'claude',text:m.message.content[0].text})+'\n');
  emit({type:'assistant',message:{content:[{type:'text',text:'Remember the blue headings.'}]}});
  emit({type:'result',subtype:'success'});return;
 }
 const reply=result=>emit({id:m.id,result});
 if(m.method==='initialize')reply({});
 if(m.method==='account/read')reply({requiresOpenaiAuth:true,account:{type:'apiKey'}});
 if(m.method==='model/list')reply({data:[{id:'gpt-test',model:'gpt-test',displayName:'GPT Test',supportedReasoningEfforts:[{reasoningEffort:'low'},{reasoningEffort:'medium'}],isDefault:true},{id:'gpt-fail',model:'gpt-fail',displayName:'Unavailable at start',supportedReasoningEfforts:[]}],nextCursor:null});
 if(m.method==='config/read')reply({config:{mcp_servers:{},plugins:{}}});
 if(m.method==='thread/start'||m.method==='thread/resume'){
  if(p.model==='gpt-fail'){emit({id:m.id,error:{message:'Simulated backend startup failure'}});return;}
  thread=p.threadId||'codex-'+process.pid;
  const nextLock=process.env.TEST_AGENT_LOG+'.'+thread+'.lock';
  if(fs.existsSync(nextLock)){emit({id:m.id,error:{message:'Thread already has an active writer'}});return;}
  lock=nextLock;fs.writeFileSync(lock,String(process.pid));
  reply({thread:{id:thread},model:p.model});
 }
 if(m.method==='turn/start'){
  const id='turn-'+(++turn);reply({turn:{id}});
  fs.appendFileSync(process.env.TEST_AGENT_LOG,JSON.stringify({provider:'codex',text:p.input[0].text})+'\n');
  emit({method:'item/completed',params:{threadId:thread,turnId:id,item:{type:'agentMessage',text:'Done.'}}});
  setTimeout(()=>emit({method:'turn/completed',params:{threadId:thread,turn:{id,status:'completed'}}}),10);
 }
 if(m.method==='turn/interrupt'){reply({});emit({method:'turn/completed',params:{threadId:thread,turn:{id:'turn-'+turn,status:'interrupted'}}});}
});
